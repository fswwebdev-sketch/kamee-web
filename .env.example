# URL publik situs (untuk SEO, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL API Laravel (kamee-api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# enabled = pakai mock MSW (UI jalan tanpa backend). Kosongkan / disabled untuk API asli.
NEXT_PUBLIC_API_MOCKING=enabled

# Kontak & sosial
NEXT_PUBLIC_WHATSAPP_NUMBER=6281211110001
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/kameecoffee
NEXT_PUBLIC_TIKTOK=https://tiktok.com/@kameecoffee
NEXT_PUBLIC_EMAIL=halo@kamee.id

# Tile peta pemilih alamat (Leaflet). Default: OpenStreetMap
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Cloudflare Turnstile untuk form kontak (opsional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# Rahasia on-demand ISR: Laravel memanggil POST /api/revalidate dengan header x-revalidate-secret
REVALIDATE_SECRET=ganti-dengan-string-acak
