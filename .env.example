APP_NAME="Kamee API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kamee
DB_USERNAME=kamee
DB_PASSWORD=secret

# --- Redis: cache, queue, lock ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

FILESYSTEM_DISK=public

# --- Sanctum (menit; kosongkan = tidak kedaluwarsa) ---
SANCTUM_EXPIRATION=

# --- Realtime: Laravel Reverb ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=kamee
REVERB_APP_KEY=kamee-key
REVERB_APP_SECRET=kamee-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Pembayaran ---
# manual   : QRIS statis (GoPay Merchant) + konfirmasi manual oleh admin (default)
# midtrans : Midtrans Core API (QRIS dinamis, e-wallet, VA) + webhook
# fake     : simulator lokal, tanpa koneksi ke Midtrans
PAYMENT_GATEWAY=manual
# Metode yang diterima saat checkout (pisahkan koma): qris, ewallet, bank_transfer, cash
KAMEE_PAYMENT_METHODS=qris,cash
# QRIS statis untuk gateway manual (URL gambar QR yang ditampilkan ke pelanggan)
KAMEE_QRIS_IMAGE_URL="${FRONTEND_URL}/payments/qris-kameecoffee.jpg"
KAMEE_QRIS_MERCHANT=KAMEECOFFEE
KAMEE_QRIS_NMID=ID1026594722880

MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CALLBACK_URL="${FRONTEND_URL}/pesanan"

# --- WhatsApp: log | fonnte ---
WHATSAPP_DRIVER=log
FONNTE_TOKEN=

# --- Captcha form kontak (kosongkan untuk menonaktifkan di lokal) ---
TURNSTILE_SECRET_KEY=

# --- Bisnis ---
KAMEE_PAYMENT_TIMEOUT=60
KAMEE_SERVICE_FEE=0
KAMEE_WHATSAPP_NUMBER=6281280871630

# Batas request panel admin per akun per menit
KAMEE_ADMIN_RATE_LIMIT=300
