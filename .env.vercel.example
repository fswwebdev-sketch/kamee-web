# =============================================================================
# Kamee API — Environment Variables untuk Vercel + Supabase
# Salin setiap baris (NAMA=nilai) ke Vercel → Project → Settings → Environment Variables
# (Environment: Production, dan Preview bila dipakai). JANGAN commit nilai asli ke GitHub.
# Panduan lengkap: README → "13. Deploy: GitHub + Vercel + Supabase".
# =============================================================================

# --- Aplikasi ---
APP_NAME="Kamee API"
APP_ENV=production
APP_DEBUG=false
# Buat sekali: `php artisan key:generate --show` (atau minta asisten). Formatnya base64:xxxx. Jangan diganti setelah live
# (token login & data terenkripsi menjadi tidak valid).
APP_KEY=base64:GANTI_DENGAN_KUNCI_ACAK
# Domain API (setelah custom domain aktif); sementara boleh https://<project>.vercel.app
APP_URL=https://api.kameecoffee.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
BCRYPT_ROUNDS=12
LOG_LEVEL=info

# --- Frontend & CORS ---
# Domain web Next.js (kamee-web). CORS_ALLOWED_ORIGINS: daftar origin dipisah koma (kosong = FRONTEND_URL).
FRONTEND_URL=https://kameecoffee.id
CORS_ALLOWED_ORIGINS=https://kameecoffee.id,https://www.kameecoffee.id
# Opsional, regex untuk URL preview Vercel kamee-web:
# CORS_ALLOWED_ORIGIN_PATTERNS=#^https://kamee-web-[a-z0-9-]+\.vercel\.app$#

# --- Database: Supabase Postgres lewat Transaction pooler (Supavisor) ---
# Supabase → Project → tombol "Connect" → "Transaction pooler" (salin host persis, mis. aws-0-/aws-1-...). Koneksi langsung db.<ref>.supabase.co
# hanya IPv6 sehingga tidak bisa dipakai dari Vercel; gunakan pooler.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
# Format user pooler: postgres.<project-ref>
DB_USERNAME=postgres.abcdefghijklmnopqrst
DB_PASSWORD=GANTI_DENGAN_DATABASE_PASSWORD
DB_SSLMODE=require
# Wajib untuk port 6543 (mode transaksi tidak mendukung prepared statement bernama).
# Bila memakai Session pooler (port 5432 di host pooler yang sama) boleh false.
DB_PGSQL_DISABLE_PREPARES=true
# Alternatif satu baris (password harus URL-encoded); bila diisi, menimpa DB_HOST/PORT/USERNAME/PASSWORD/DATABASE:
# DB_URL=postgresql://postgres.abcdefghijklmnopqrst:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Runtime serverless (sudah menjadi default di vercel.json & api/index.php; boleh tidak diisi) ---
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
LOG_CHANNEL=stderr
TRUSTED_PROXIES=*

# --- Seeder: produksi tanpa data demo ---
KAMEE_SEED_DEMO=false

# --- Scheduler tanpa daemon: POST /api/v1/internal/cron dengan header X-Cron-Secret ---
# String acak panjang, mis. hasil `openssl rand -hex 32`. Nilai yang sama dipakai di SQL pg_cron.
# (Vercel Cron juga otomatis mengirim "Authorization: Bearer <CRON_SECRET>".)
CRON_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# --- Unggahan gambar: Supabase Storage (S3) ---
# Supabase → Storage → buat bucket "kamee" (Public) → Settings (S3) → "New access key".
# Disk unggahan mengikuti FILESYSTEM_DISK (bisa ditimpa MEDIA_DISK). Endpoint & region: salin dari halaman S3 tsb.
FILESYSTEM_DISK=supabase
SUPABASE_S3_ENDPOINT=https://abcdefghijklmnopqrst.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_KEY=GANTI_DENGAN_ACCESS_KEY_ID
SUPABASE_S3_SECRET=GANTI_DENGAN_SECRET_ACCESS_KEY
SUPABASE_S3_BUCKET=kamee
SUPABASE_PUBLIC_URL=https://abcdefghijklmnopqrst.supabase.co/storage/v1/object/public/kamee

# --- Pembayaran ---
PAYMENT_GATEWAY=manual
KAMEE_PAYMENT_METHODS=qris,cash
KAMEE_QRIS_IMAGE_URL=https://kameecoffee.id/payments/qris-kameecoffee.jpg
KAMEE_QRIS_MERCHANT=KAMEECOFFEE
KAMEE_QRIS_NMID=ID1026594722880
# Hanya bila PAYMENT_GATEWAY=midtrans:
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=true
# MIDTRANS_CALLBACK_URL=https://kameecoffee.id/pesanan

# --- Bisnis ---
KAMEE_PAYMENT_TIMEOUT=60
KAMEE_SERVICE_FEE=0
KAMEE_WHATSAPP_NUMBER=6281280871630
KAMEE_ADMIN_RATE_LIMIT=300
# Masa berlaku token login (menit); kosong = tidak kedaluwarsa
SANCTUM_EXPIRATION=

# --- WhatsApp: log | fonnte ---
WHATSAPP_DRIVER=log
FONNTE_TOKEN=

# --- Captcha form kontak (Cloudflare Turnstile; kosong = nonaktif) ---
TURNSTILE_SECRET_KEY=
